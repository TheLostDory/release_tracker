// Cloudflare Workers (static assets) deployment. Not needed for Cloudflare Pages.
// `name` must match the Worker name shown in the Cloudflare dashboard.
{
  "name": "release-tracker",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths (e.g. /releases/123) serve index.html; the app routes client-side.
    "not_found_handling": "single-page-application"
  }
}
