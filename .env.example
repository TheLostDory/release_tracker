# Local development (npm run dev:server / npm run db:migrate). Copy to .env.
# Start a database first, e.g.: docker compose up -d db
DATABASE_URL=postgres://release_tracker_app:dev-app-password-123@127.0.0.1:54329/release_tracker
DATABASE_OWNER_URL=postgres://postgres:dev-owner-password@127.0.0.1:54329/release_tracker
APP_DB_PASSWORD=dev-app-password-123
SEED=true
PORT=3000
# 32+ random characters; encrypts Jira/Jenkins credentials. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=
