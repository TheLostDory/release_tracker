{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "outDir": "dist-server",
    "rootDir": ".",
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "sourceMap": true,
    // Shared, framework-free rules from the frontend (e.g. action items for the daily summary).
    "paths": { "@/*": ["./src/*.ts"] }
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts"]
}
