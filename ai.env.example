# AI assistant ("Ask" button). Copy to ai.env (never committed), fill in, then:
#   docker compose up -d
# The key and secret stay on the server; browsers never see them.

# Base address of the company AI gateway (airelay), without the path.
AI_BASE_URL=https://airelay.example.com

# Request format the gateway speaks:
#   gemini → POST {AI_PATH} with Gemini "generateContent" JSON (contents/parts)
#   openai → POST {AI_PATH} with OpenAI "chat/completions" JSON (messages)
AI_FORMAT=gemini
AI_MODEL=gemini-2.5-flash
# Path after AI_BASE_URL; {model} is replaced. Defaults:
#   gemini: /v1beta/models/{model}:generateContent
#   openai: /v1/chat/completions
#AI_PATH=/v1beta/models/{model}:generateContent

AI_API_KEY=
AI_API_SECRET=
# How the key and secret are sent, as JSON; {key} and {secret} are replaced.
# Use the header names from your gateway's docs. Examples:
#   {"X-App-Key":"{key}","X-App-Secret":"{secret}"}
#   {"Authorization":"Bearer {key}"}
AI_HEADERS={"X-App-Key":"{key}","X-App-Secret":"{secret}"}

# Only if the gateway uses a company HTTPS certificate (SELF_SIGNED_CERT_IN_CHAIN):
# the root certificate in PEM on one line, with \n for line breaks.
#AI_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----
