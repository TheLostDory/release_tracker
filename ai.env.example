# AI assistant ("Ask" button). Copy to ai.env (never committed), fill in, then:
#   docker compose up -d
#   docker compose exec app node dist-server/server/ai/check.js
# Client secrets and keys stay on the server; browsers never see them.

# --- Gemini on Vertex AI through Apigee (OAuth client credentials) -----------
# Using the AI Relay IDE extension already? Copy the values from its file
# ~/.airelay/config.properties (Windows: %USERPROFILE%\.airelay\config.properties):
#   vertex.endpoint      → AI_BASE_URL (add https:// in front if it's missing)
#   vertex.project       → AI_PROJECT_ID
#   vertex.location      → AI_LOCATION
#   gemini.model         → AI_MODEL (the gateway's own model id)
#   apigee.token.url     → AI_TOKEN_URL
#   apigee.client.id     → AI_CLIENT_ID
#   apigee.client.secret → AI_CLIENT_SECRET
AI_FORMAT=vertex
# Apigee gateway address, including any path the gateway has.
AI_BASE_URL=https://apigee.example.com
# Google Cloud project id and location (region).
AI_PROJECT_ID=
AI_LOCATION=us-central1
# The model id the gateway exposes (AI Relay calls these "accessible models").
AI_MODEL=gemini-2.5-flash

# OAuth token URL, client id and client secret from Apigee.
AI_TOKEN_URL=https://apigee.example.com/oauth/token
AI_CLIENT_ID=
AI_CLIENT_SECRET=
# How the client id/secret are sent: basic (Authorization header, the usual)
# or body (client_id/client_secret form fields). Try "body" if "basic" gets 401.
#AI_TOKEN_AUTH=basic
# Only if your gateway asks for a scope:
#AI_TOKEN_SCOPE=

# The request goes to (the same as AI Relay):
#   {AI_BASE_URL}/v1/projects/{project}/locations/{location}/publishers/google/models/{model}:streamGenerateContent?alt=sse
# with "Authorization: Bearer <token>". If your Apigee proxy uses a different
# path, set it here ({project}, {location}, {model} are replaced):
#AI_PATH=/v1/projects/{project}/locations/{location}/publishers/google/models/{model}:streamGenerateContent?alt=sse
# Extra/different headers, as JSON ({token}, {model}, {project}, {location}
# are replaced). Replaces the default Authorization header, so keep it:
#AI_HEADERS={"Authorization":"Bearer {token}","x-model":"{model}"}

# Only if the gateway accepts known clients only (the check suggests it):
#AI_USER_AGENT=Java/21.0.4

# --- Only if Apigee uses a company HTTPS certificate --------------------------
# The check command prints this line for you when it's needed.
#AI_CA_CERT=-----BEGIN CERTIFICATE-----\nMIID...\n-----END CERTIFICATE-----

# --- Other gateways (instead of the above) -------------------------------------
# AI_FORMAT=gemini → Gemini API generateContent, AI_FORMAT=openai → chat/completions,
# with a static key/secret: AI_API_KEY=, AI_API_SECRET=,
#   AI_HEADERS={"X-App-Key":"{key}","X-App-Secret":"{secret}"}
